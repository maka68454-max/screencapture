{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "screencapture-docs",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}