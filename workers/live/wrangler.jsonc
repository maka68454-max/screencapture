{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "screencapture-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "secrets": {
    "required": ["CALLS_APP_ID", "CALLS_APP_SECRET"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_STREAM_ROOMS",
        "class_name": "LiveStreamRoom"
      }
    ]
  },
  "exports": {
    "LiveStreamRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}